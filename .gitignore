## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
bin/
obj/
Debug/
Release/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider files
.idea/

# Autogenerated files
Generated_Code/

# NuGet
*.nupkg
*.snupkg
packages/
*.nuget.props
*.nuget.targets

# MSBuild binary log
*.binlog

# Logs
*.log

# Visual Studio Code
.vscode/

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Others
*.dbmdl
*.bak
*.sql
*.ldf
*.mdf

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# StyleCop
StyleCopReport.xml

# TFS
$tf/

# DotCover
*.dotCover

# NCrunch
_NCrunch_*
.*crunch*.local.xml

# Azure Functions local settings
local.settings.json

# Publish outputs
publish/
*.pubxml
*.publishproj

# Backup & crash files
*.bak
*.swp
*.tmp
*.temp

# JetBrains Rider
.idea/

# Others
*.pidb
*.svclog
*.scc

# Entity Framework
Migrations/

# Coverage tools
coverage/
*.coverage
*.coveragexml

# Node.js (if using frontend in same repo)
node_modules/

# Mac files
.DS_Store

# Windows files
Thumbs.db
ehthumbs.db
Desktop.ini

